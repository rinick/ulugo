{
  "name": "ulugo",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ulugo/web dev",
    "dev:electron": "pnpm --filter @ulugo/web build && pnpm --filter @ulugo/electron dev",
    "build": "pnpm -r build",
    "build:electron": "pnpm --filter @ulugo/web build && pnpm --filter @ulugo/electron build",
    "build:win-x64": "pnpm build:electron && pnpm --filter @ulugo/electron package:win-x64",
    "build:msix-x64": "pnpm build:electron && pnpm --filter @ulugo/electron package:msix-x64",
    "build:mac-arm64": "pnpm build:electron && pnpm --filter @ulugo/electron package:mac-arm64",
    "build:linux-x64": "pnpm build:electron && pnpm --filter @ulugo/electron package:linux-x64",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "prettier-check": "prettier --check \"{packages,apps}/**/*.{ts,tsx}\"",
    "prettier-write": "prettier --write \"{packages,apps}/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@vitejs/plugin-react": "^5.1.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.14"
  },
  "packageManager": "pnpm@11.3.0"
}
